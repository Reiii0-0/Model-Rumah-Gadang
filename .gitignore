# Dependencies
node_modules/

# Production build & local caches
dist/
.vite/
*.tsbuildinfo

# Generated public mirror (auto-synced from references/ on dev & build)
public/references/

# Source distribution archives
*.zip
*.tar.gz

# Firebase local deploy cache & debug logs
.firebase/
firebase-debug.log*
ui-debug.log*

# Playwright / automated test transient failure dumps
evidence/**/startup-error.png
playwright-report/
test-results/

# Python caches
__pycache__/
*.py[cod]

# Environment & local secrets
.env
.env.*
!.env.example

# OS & editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
