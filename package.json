{
  "name": "rumah-gadang-3d-interaktif",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi web 3D interaktif Rumah Gadang PDIKM Padang Panjang berbasis Three.js, TypeScript, dan Vite dengan dukungan dwibahasa Indonesia dan Baso Minang.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "node scripts/test-browser.mjs",
    "capture": "node scripts/capture.mjs",
    "fetch-refs": "python3 scripts/fetch-references.py",
    "package": "python3 scripts/package-source.py",
    "deploy": "npm run build && firebase deploy --only hosting",
    "predev": "node scripts/sync-references.mjs",
    "prebuild": "node scripts/sync-references.mjs",
    "pretest:e2e": "node scripts/sync-references.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
